# Read MODEL-LICENSE.md before setting this to true.
MINIMAX_H3_LICENSE_ACKNOWLEDGED=false

# SSH targets and exact host identities. Replace these generic examples with
# the aliases and hostnames for your own pair.
HEAD_HOST=spark-head
WORKER_HOST=spark-peer
EXPECTED_HEAD_HOSTNAME=spark-head
EXPECTED_WORKER_HOSTNAME=spark-peer

# Dedicated Spark fabric. Replace these documentation-only addresses.
HEAD_IP=192.0.2.10
WORKER_IP=192.0.2.11
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1
# IPv4-mapped RoCE v2 GID indices can differ after a node reboot. Discover and
# set each node independently; do not assume that one shared index is stable.
H3_HEAD_GID_INDEX=3
H3_WORKER_GID_INDEX=3

# Use the same absolute checkpoint path on both nodes.
MINIMAX_H3_MODEL_DIR=/absolute/path/to/MiniMax-H3/FL2VA
HF_CACHE_DIR=/absolute/path/to/.cache/huggingface
H3_2X_IMAGE=minimax-h3-2x-dgx-spark:experimental
# This is a local image tag produced from companion repository commit 8bd7628.
# The build script verifies the accepted local image ID and its pinned upstream
# layer ancestry before deriving the two-Spark image.
H3_BASE_IMAGE=minimax-h3-dgx-spark:sm121-fp8
# Accepted upstream digest, companion commit, and local image ID are enforced
# by scripts/build-image.sh and documented in docs/REPRODUCIBILITY.md.
H3_API_PORT=8000
H3_RAY_PORT=6379
H3_MASTER_PORT=29500

# Verified fast profile on two DGX Sparks. The first request compiles repeated
# H3 blocks; measure steady-state performance from the second request onward.
H3_DIFFUSION_ATTENTION_BACKEND=CUDNN_ATTN
H3_EXECUTION_MODE=compile

# The default launcher keeps cache reuse disabled. Start the measured optional
# balanced profile with scripts/start-cache-dit-profile.sh instead.
H3_CACHE_BACKEND=none
H3_ENABLE_CACHE_DIT_SUMMARY=false
