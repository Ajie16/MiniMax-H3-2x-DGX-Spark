+@contextmanager
+def _posterior_mean_encoding(remote: nn.Module):
+    """Match the reference (ComfyUI) VAE conditioning contract.
+
+    The checkpoint's KL VAE samples from the posterior by default
+    (``DiagonalGaussianDistribution.sample()``). The reference pipeline
+    conditions on the posterior mean instead, computed in FP32. Sampling
+    injects per-request noise into the reference/keyframe latents, which
+    visibly degrades identity and detail retention.
+    """
+    package = remote.__class__.__module__.rsplit(".", 1)[0]
+    vae_module = importlib.import_module(f"{package}.vae_module")
+    distribution = vae_module.DiagonalGaussianDistribution
+    original_sample = distribution.sample
+
+    @torch.compiler.disable
+    def _posterior_mean(self, generator=None):
+        return self.mean
+
+    distribution.sample = _posterior_mean
+    try:
+        yield
+    finally:
+        distribution.sample = original_sample
+
+
